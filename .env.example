# Required
OPENROUTER_API_KEY=sk-or-v1-...
FIRECRAWL_API_KEY=fc-...

# Models (defaults shown)
SUMMARISER_MODEL=scaledown/summarize
CHAT_MODEL=google/gemma-4-31b-it:free
# Tried in order when the primary chat model is rate-limited or failing
CHAT_FALLBACK_MODELS=poolside/laguna-s-2.1:free,dots-studio/dots-3-note-preview:free,recursive/flint-v1.0:free,cohere/north-mini-code:free,openrouter/free
MAMMOTH_MODEL=baseten/mammoth-1:free

# Set to 0 to skip the mammoth groundedness badge
MAMMOTH_CONFIDENCE=1

# Optional tuning
MAX_SOURCE_CHARS=200000
CHAT_CONTEXT_CHARS=120000
SESSION_TTL_MINUTES=180
